# PortOS server configuration (copy to .env and adjust)

# Listen address
PORTOS_BIND_ADDR=0.0.0.0:8080

# SQLite database file (created + migrated automatically)
PORTOS_DB_PATH=data/portos.db

# JWT signing secret — REQUIRED in production (>= 32 chars).
# Generate: openssl rand -hex 32
PORTOS_JWT_SECRET=dev-only-secret-change-me-in-production-0f3a
# Refuse to boot with the dev default or a short secret when set to 1
PORTOS_REQUIRE_SECRET=0
PORTOS_JWT_TTL_HOURS=8

# Tenant / terminal code stamped into events + audit (multi-terminal, F-46)
PORTOS_TENANT=IRBND-CT1

# Default UI language for unauthenticated requests: en | fa
PORTOS_DEFAULT_LOCALE=en

# CORS origins, comma-separated ("*" for development only)
PORTOS_CORS_ORIGINS=*

# Trust X-Forwarded-For for client IPs when behind a reverse proxy.
# Leave 0 when clients can reach the server directly (prevents IP spoofing).
PORTOS_TRUST_PROXY=0

# Rate limiting
PORTOS_RATE_LIMIT_RPS=100
PORTOS_LOGIN_RATE_PER_MIN=10
PORTOS_BODY_LIMIT_BYTES=2097152
PORTOS_TIMEOUT_SECS=30

# Observability
PORTOS_LOG_FORMAT=json        # json | pretty
# RUST_LOG=info,portosd=debug

# Localization overrides (L-10): colon-separated directories with <locale>.json
# PORTOS_I18N_EXTRA_DIRS=/etc/portos/i18n

# Webhooks
PORTOS_WEBHOOK_TIMEOUT_SECS=10
